<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:background="@color/white"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FONT VIỆT LINH"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textSize="20sp"
            android:textColor="@color/ink"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Font Viewer 2.0"
            android:textSize="12sp"
            android:textColor="@color/muted"/>

        <TextView
            android:id="@+id/tvFontName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:text="Chưa chọn font"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/ink" />
        <TextView
            android:id="@+id/tvFontInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Mở file .ttf hoặc .otf để bắt đầu"
            android:textSize="12sp"
            android:textColor="@color/muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickFont"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="MỞ FONT TTF / OTF"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:backgroundTint="@color/accent"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/white"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/accent"
        app:tabIndicatorFullWidth="false"
        app:tabSelectedTextColor="@color/accent"
        app:tabTextColor="@color/muted">
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="XEM CHỮ" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GLYPH / UNICODE" />
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/previewPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gõ nội dung để thử"
                    android:textColor="@color/ink"
                    android:textStyle="bold"
                    android:textSize="14sp" />
                <EditText
                    android:id="@+id/etCustomText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/field_background"
                    android:padding="14dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="2"
                    android:maxLines="6"
                    android:text="@string/sample_vietnamese_text"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Xem trước"
                        android:textColor="@color/ink"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvFontSizeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cỡ chữ  30 sp"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderFontSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="14"
                    android:valueTo="80"
                    android:stepSize="1"
                    android:value="30" />

                <TextView
                    android:id="@+id/tvPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/field_background"
                    android:padding="18dp"
                    android:minHeight="220dp"
                    android:text="@string/sample_vietnamese_text"
                    android:textSize="30sp"
                    android:textColor="@color/ink"
                    android:lineSpacingExtra="7dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Thử chữ có dấu: Đ đ Ă Ắ Ằ Â Ấ Ê Ế Ô Ố Ơ Ớ Ư Ứ"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/glyphPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvGlyphCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chưa nạp font"
                    android:textColor="@color/ink"
                    android:textStyle="bold"
                    android:textSize="15sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Chỉ hiển thị glyph có ánh xạ Unicode (cmap). ALT/LIGA không mã Unicode chưa được liệt kê."
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
                <EditText
                    android:id="@+id/etGlyphSearch"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/field_background"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:hint="Tìm ký tự, mã U+1EA0…"
                    android:textSize="14sp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/muted" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fillViewport="false"
                android:scrollbars="none">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/glyphChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAll"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tất cả"
                        android:checked="true" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipVietnamese"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tiếng Việt" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipLatin"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Latin" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSymbols"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Số / dấu" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/glyphGrid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="4dp"
                    android:clipToPadding="false" />
                <TextView
                    android:id="@+id/tvGlyphEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:padding="24dp"
                    android:gravity="center"
                    android:text="Chọn file font .TTF hoặc .OTF để xem Unicode thực tế."
                    android:textSize="14sp"
                    android:textColor="@color/muted" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
